        </dependency>
        <dependency>
            <groupId>com.careerpilot</groupId>
            <artifactId>career-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.careerpilot</groupId>
            <artifactId>career-token</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
