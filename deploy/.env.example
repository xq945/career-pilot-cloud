# 复制为 .env 后填写；不要提交真实密钥
MYSQL_ROOT_PASSWORD=careerpilot

# 与 application-local.yml 的 app.jwt.secret 一致（HS256，至少 32 字节）
# 生成：openssl rand -base64 48
APP_JWT_SECRET=

# Agent 与 AI 服务使用的平台模型 Key
DEEPSEEK_API_KEY=

# 用户级 Provider 的 AES-GCM 主密钥（演示可用任意 ≥16 字符；生产请轮换）
APP_LLM_ENCRYPTION_KEY=

# RabbitMQ 默认账号（同时注入到各服务）
RABBITMQ_DEFAULT_USER=careerpilot
RABBITMQ_DEFAULT_PASS=careerpilot

# 演示环境可关闭验证码，便于脚本登录
APP_CAPTCHA_ENABLED=false
